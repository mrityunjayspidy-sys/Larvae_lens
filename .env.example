# ==============================================================================
# Web - Public frontend variables (apps/web/.env)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==============================================================================
# API - Server-side secrets & configuration (apps/api/.env)
# ==============================================================================
APP_ENV=development
APP_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
MODEL_DIR=d:/larva_lens/apps/api/models/active
MAX_VIDEO_MB=80
MAX_VIDEO_SECONDS=15
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/webm,video/quicktime
ENABLE_SPECIES_MODEL=false
LOG_LEVEL=INFO
